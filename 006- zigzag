import java.util.ArrayList;
import java.util.List;

class Solution {
    public String convert(String s, int numRows) {
        // Edge cases: no conversion needed if numRows is 1 or string is too short
        if (numRows == 1 || s.length() <= numRows) {
            return s;
        }

        // Initialize a list of StringBuilder objects for each row
        List<StringBuilder> rows = new ArrayList<>();
        for (int i = 0; i < Math.min(numRows, s.length()); i++) {
            rows.add(new StringBuilder());
        }

        int currentRow = 0;
        boolean goingDown = false;

        // Traverse the string and distribute characters into rows
        for (char c : s.toCharArray()) {
            rows.get(currentRow).append(c);

            // Change direction when hitting the topmost or bottommost row
            if (currentRow == 0 || currentRow == numRows - 1) {
                goingDown = !goingDown;
            }

            // Move the row pointer up or down
            currentRow += goingDown ? 1 : -1;
        }

        // Combine all rows into a single resulting string
        StringBuilder result = new StringBuilder();
        for (StringBuilder row : rows) {
            result.append(row);
        }

        return result.toString();
    }
}
