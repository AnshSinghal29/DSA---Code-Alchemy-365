import java.util.*;
class Main{
   public static void main(String[] args){
       Scanner sc = new Scanner(System.in);
       int n = sc.nextInt();
       int[] arr = new int[n];

       int minVal = Integer.MAX_VALUE;
       int maxVal = Integer.MIN_VALUE;
       int MaxIdx = -1;
       int MinIdx = -1;

       for(int i = 0; i < n;i++){
           arr[i] = sc.nextInt();
           if(arr[i]<minVal){
               minVal = arr[i];
               MinIdx = i;
           }else if(arr[i]>maxVal) {
               maxVal = arr[i];
               MaxIdx = i;
           }
       }

       int loc1 = Math.min(MinIdx,MaxIdx);
       int loc2 = Math.max(MinIdx,MaxIdx);

       for(int i = loc1; i < loc2; i++){
           System.out.println(arr[i] + " ");
       }
       for(int i = 0; i < loc1; i++){
           System.out.println(arr[i] + " ");
       }
       for(int i = loc2; i < n; i++){
           System.out.println(arr[i] + " ");
       }

       sc.close();
   }
}
